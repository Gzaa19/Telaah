# Application
APP_NAME=Telaah - Scientific Journal Paper Generator
DEBUG=True
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL with pgvector in Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rpg_dev

# Security & Encryption (Fernet 32-byte urlsafe base64 key)
SECRET_KEY=change-this-to-a-secure-random-secret
TOKEN_ENCRYPTION_KEY=dGhpc2lzYTMyeWVhcm9sZHNlY3JldGtleWZvcmZlcm5ldDEyMzQ=

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# CORS
CORS_ORIGINS=["http://localhost:3000"]
